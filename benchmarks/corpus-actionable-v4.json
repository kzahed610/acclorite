{
  "schema_version": 1,
  "name": "acclorite-actionable-v4",
  "description": "Milestone-10 practical binding corpus. Carries forward v3 and adds verified root-SYNOPSIS binding for common multi-argument commands so actionable answers cover ordinary copy/move/search/create/remove tasks, not only subcommands and isolated options.",
  "cases": [
    {
      "id": "systemctl-status-bind-unit",
      "query": "systemctl show me what nginx is doing",
      "tags": [
        "actionable",
        "human",
        "subcommand",
        "binding",
        "complete"
      ],
      "expect": {
        "top1_any": [
          "systemctl"
        ],
        "frame": "Inspect",
        "action_target_kind": "subcommand",
        "action_target_command": "systemctl",
        "actionable_present": true,
        "actionable_command": "systemctl",
        "actionable_subcommand_any": [
          "status"
        ],
        "invocation_present": true,
        "invocation_command": "systemctl",
        "invocation_arguments": [
          "status",
          "nginx"
        ],
        "invocation_complete": true,
        "invocation_placeholder_count": 0
      }
    },
