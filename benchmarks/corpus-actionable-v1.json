{
  "schema_version": 1,
  "name": "acclorite-actionable-v1",
  "description": "Milestone-10 actionable-answer corpus. Measures verified syntax selection, conservative argument binding, invocation completeness, and refusal to overclaim when grammar is insufficient. This corpus is additive to the frozen discovery and human-language gates.",
  "cases": [
    {
      "id": "systemctl-status-bind-unit",
      "query": "systemctl show me what nginx is doing",
      "tags": ["actionable", "human", "subcommand", "binding", "complete"],
      "expect": {
        "top1_any": ["systemctl"],
        "frame": "Inspect",
        "action_target_kind": "subcommand",
        "action_target_command": "systemctl",
        "actionable_present": true,
        "actionable_command": "systemctl",
        "actionable_subcommand_any": ["status"],
        "invocation_present": true,
        "invocation_command": "systemctl",
        "invocation_arguments": ["status", "nginx"],
        "invocation_complete": true,
        "invocation_placeholder_count": 0
      }
    },
    {
      "id": "systemctl-status-bind-many",
      "query": "systemctl show what nginx and sshd are doing",
      "tags": ["actionable", "human", "subcommand", "binding", "variadic"],
      "expect": {
        "top1_any": ["systemctl"],
        "action_target_kind": "subcommand",
        "actionable_present": true,
        "actionable_subcommand_any": ["status"],
        "invocation_present": true,
        "invocation_arguments": ["status", "nginx", "sshd"],
        "invocation_complete": true,
        "invocation_placeholder_count": 0
      }
    },
    {
      "id": "ffmpeg-seek-bind-value",
      "query": "ffmpeg start reading this video from 30 seconds in",
      "tags": ["actionable", "human", "option", "binding", "partial"],
      "expect": {
        "top1_any": ["ffmpeg"],
        "action_target_kind": "option",
        "actionable_present": true,
        "actionable_option_any": ["-ss"],
        "invocation_present": true,
        "invocation_command": "ffmpeg",
        "invocation_arguments": ["-ss", "30"],
        "invocation_complete": false,
        "invocation_placeholder_count": 0
      }
    },
    {
      "id": "ffmpeg-explain-does-not-bind",
      "query": "what does ffmpeg -ss do",
      "tags": ["actionable", "explain", "option", "no-overclaim"],
      "expect": {
        "top1_any": ["ffmpeg"],
        "frame": "Explain",
        "actionable_present": true,
        "actionable_option_any": ["-ss"],
        "invocation_present": false
      }
    },
    {
      "id": "git-branch-root-grammar-insufficient",
      "query": "git make a fresh branch called feature/foo and put me on it",
      "tags": ["actionable", "human", "subcommand", "no-overclaim", "future-child-grammar"],
      "expect": {
        "top1_any": ["git"],
        "frame": "Modify",
        "actionable_present": true,
        "actionable_subcommand_any": ["branch"],
        "invocation_present": false
      }
    },
    {
      "id": "rg-hidden-root-grammar-insufficient",
      "query": "rg is skipping dotfiles, make it search them too",
      "tags": ["actionable", "human", "option", "no-overclaim"],
      "expect": {
        "top1_any": ["rg"],
        "actionable_present": true,
        "actionable_option_any": ["--hidden", "-."],
        "invocation_present": false
      }
    }
  ]
}
