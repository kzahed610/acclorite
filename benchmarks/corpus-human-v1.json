      "tags": ["human", "media", "conversion"],
      "expect": {
        "top1_any": ["magick", "convert", "mogrify", "gm", "vips", "ffmpeg"],
        "top3_any": ["magick", "convert", "mogrify", "gm", "vips", "ffmpeg"]
      }
    },
    {
      "id": "duplicate-files-again",
      "query": "what's that terminal thing for finding duplicate files again",
      "tags": ["human", "memory", "files"],
      "expect": {
        "top1_any": ["fdupes", "rdfind", "fclones", "jdupes"],
        "top3_any": ["fdupes", "rdfind", "fclones", "jdupes"],
        "frame": "Discover",
        "targets_none": true
      }
    },
    {
      "id": "connections-on-this-box",
      "query": "need to see open connections on this box",
      "tags": ["human", "network", "inspect"],
      "expect": {
        "top1_any": ["ss", "lsof", "netstat"],
        "top3_any": ["ss", "lsof", "netstat"],
