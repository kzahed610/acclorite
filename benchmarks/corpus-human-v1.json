{
  "schema_version": 1,
  "name": "acclorite-human-language-v1",
  "description": "Adversarial human-language benchmark for incomplete recall, slang, filler, typos, implied operations, and syntax requests that do not use Acclorite's ontology words. This corpus is additive; corpus-v1.json remains the frozen discovery regression gate.",
  "cases": [
    {
      "id": "unknown-command-extract-targz",
      "query": "What is that command that can extract tar.gz files in terminal",
      "tags": ["human", "implicit-tool", "archive", "filler"],
      "expect": {
        "top1_any": ["tar", "bsdtar", "ark"],
        "top3_any": ["tar", "bsdtar", "ark"],
        "frame": "Discover",
        "targets_none": true
      }
    },
    {
      "id": "downloaded-targz-unpack",
      "query": "i downloaded some .tar.gz thing how tf do i unpack it",
      "tags": ["human", "slang", "implicit-tool", "archive"],
      "expect": {
        "top1_any": ["tar", "bsdtar", "ark"],
        "top3_any": ["tar", "bsdtar", "ark"],
        "frame": "Discover"
      }
    },
    {
      "id": "compress-directory-one-file",
      "query": "got a directory and need to turn it into one compressed file from terminal",
      "tags": ["human", "implicit-tool", "archive"],
      "expect": {
        "top1_any": ["tar", "zip", "7z", "7zz", "ark"],
        "top3_any": ["tar", "zip", "7z", "7zz", "ark"]
      }
    },
    {
      "id": "disk-full-what-ate-it",
      "query": "my drive is full what the hell ate all the space",
      "tags": ["human", "slang", "storage", "implicit-tool"],
      "expect": {
        "top1_any": ["duf", "ncdu", "gdu", "dua", "pdu", "du", "btop"],
        "top3_any": ["duf", "ncdu", "gdu", "dua", "pdu", "du", "btop"],
        "frame": "Inspect"
      }
    },
    {
      "id": "port-stolen-8080",
      "query": "what terminal thing tells me which process stole port 8080",
      "tags": ["human", "metaphor", "network", "implicit-tool"],
      "expect": {
        "top1_any": ["fuser", "ss", "lsof"],
        "top3_any": ["fuser", "ss", "lsof"],
        "frame": "Inspect"
      }
    },
    {
      "id": "disk-exploding-large-files",
      "query": "need to hunt down giant files before my disk explodes",
      "tags": ["human", "slang", "files", "storage"],
      "expect": {
        "top1_any": ["find", "du", "ncdu", "gdu", "dua", "dust", "fd"],
        "top3_any": ["find", "du", "ncdu", "gdu", "dua", "dust", "fd"]
      }
    },
    {
      "id": "grep-everything-todo",
      "query": "grep through everything under this folder for TODO",
      "tags": ["human", "verb-as-tool", "search"],
      "expect": {
        "top1_any": ["rg", "grep"],
        "top3_any": ["rg", "grep"]
      }
    },
    {
      "id": "compare-dirs-whats-different",
      "query": "what can compare these two directories and tell me what's different",
      "tags": ["human", "files", "compare"],
      "expect": {
        "top1_any": ["diff", "meld", "rsync", "kompare"],
        "top3_any": ["diff", "meld", "rsync", "kompare"],
        "frame": "Discover"
      }
    },
    {
      "id": "rename-five-hundred-files",
      "query": "i have like 500 files and need to rename all of them",
      "tags": ["human", "files", "bulk"],
      "expect": {
        "top1_any": ["rename", "perl-rename", "mmv", "qmv", "vidir"],
        "top3_any": ["rename", "perl-rename", "mmv", "qmv", "vidir"]
      }
    },
    {
      "id": "png-to-jpg-bunch",
