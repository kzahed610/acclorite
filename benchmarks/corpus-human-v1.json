      }
    },
    {
      "id": "rg-dotfiles-without-flag-word",
      "query": "rg is skipping dotfiles, make it search them too",
      "tags": ["human", "implicit-syntax", "option", "search"],
      "expect": {
        "top1_any": ["rg"],
        "top3_any": ["rg"],
        "action_target_kind": "option",
        "action_target_command": "rg",
        "actionable_present": true,
        "actionable_command": "rg",
        "actionable_option_any": ["--hidden", "-."]
      }
    },
    {
      "id": "curl-3xx-follow-without-flag-word",
      "query": "curl keeps getting 3xx responses and stopping, make it follow the redirect",
      "tags": ["human", "implicit-syntax", "option", "network"],
      "expect": {
        "top1_any": ["curl"],
        "top3_any": ["curl"],
        "action_target_kind": "option",
        "action_target_command": "curl",
        "actionable_present": true,
        "actionable_command": "curl",
        "actionable_option_any": ["--follow", "-L", "--location"]
      }
    },
    {
      "id": "git-branch-and-go-there",
      "query": "git make a fresh branch called feature/foo and put me on it",
      "tags": ["human", "implicit-syntax", "multi-action", "git"],
      "expect": {
        "top1_any": ["git"],
        "top3_any": ["git"],
        "frame": "Modify"
      }
    },
    {
