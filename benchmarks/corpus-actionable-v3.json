        "actionable_command": "systemctl",
        "actionable_subcommand_any": [
          "status"
        ],
        "invocation_present": true,
        "invocation_command": "systemctl",
        "invocation_arguments": [
          "status",
          "nginx"
        ],
        "invocation_complete": true,
        "invocation_placeholder_count": 0
